#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);

    while (T--) {
        int N;
        scanf("%d", &N);

        int size = 2 * N;
        long long A[size];

        // Read all candy prices
        for (int i = 0; i < size; i++) {
            scanf("%lld", &A[i]);
        }

        int valid = 1;

        // Check how many times each element occurs
        for (int i = 0; i < size; i++) {
            int count = 0;

            for (int j = 0; j < size; j++) {
                if (A[i] == A[j]) {
                    count++;
                }
            }

            // A price cannot appear more than twice
            if (count > 2) {
                valid = 0;
                break;
            }
        }

        if (valid)
            printf("Yes\n");
        else
            printf("No\n");
    }

    return 0;
}
