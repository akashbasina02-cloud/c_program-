#include <stdio.h>

int main() {
    int x, y, z, m;

    // Take X, Y and K as input
    scanf("%d %d %d", &x, &y, &z);

    // Find the distance between X and Y
    if (x >= y) {
        m = x - y;
    } else {
        m = y - x;
    }

    // Check if the robot has enough battery to reach Y
    if (m <= z) {
        printf("YES\n");
    } else {
        printf("NO\n");
    }

    return 0;
}
