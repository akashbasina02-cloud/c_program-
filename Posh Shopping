#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);

    while (T--) {
        int N;
        scanf("%d", &N);

        int C[N];

        for (int i = 0; i < N; i++) {
            scanf("%d", &C[i]);
        }

        int max = 0;

        for (int i = 0; i < N; i++) {

            // Buy only one item
            if (C[i] > max) {
                max = C[i];
            }

            // Buy two items
            for (int j = i + 1; j < N; j++) {

                if (C[i] <= C[j]) {
                    int sum = C[i] + C[j];

                    if (sum > max) {
                        max = sum;
                    }
                }
            }
        }

        printf("%d\n", max);
    }

    return 0;
}
