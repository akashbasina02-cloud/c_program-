#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);

    while (T--) {
        int N;
        char S[105];

        scanf("%d", &N);
        scanf("%s", S);

        // Step 1: Swap adjacent characters
        for (int i = 0; i < N - 1; i += 2) {
            char temp = S[i];
            S[i] = S[i + 1];
            S[i + 1] = temp;
        }

        // Step 2:
        // a -> z
        // b -> y
        // c -> x
        // ...
        for (int i = 0; i < N; i++) {
            S[i] = 'a' + 'z' - S[i];
        }

        printf("%s\n", S);
    }

    return 0;
}
