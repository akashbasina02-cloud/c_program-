#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);

    while (T--) {
        int N;
        scanf("%d", &N);

        int ans = 0;

        for (int i = 0; i < N; i++) {
            int doll;
            scanf("%d", &doll);

            // XOR removes pairs
            ans = ans ^ doll;
        }

        printf("%d\n", ans);
    }

    return 0;
}
