#include <stdio.h>
#include <stdlib.h>

int main() {
    int T;
    scanf("%d", &T);

    while (T--) {
        int N;
        scanf("%d", &N);

        int sum = 0;
        int x;

        // Read the array and calculate its sum
        for (int i = 0; i < N; i++) {
            scanf("%d", &x);
            sum += x;
        }

        // If N is odd, sum can never become 0
        if (N % 2 != 0) {
            printf("-1\n");
        }
        // If sum is already 0, no flips are needed
        else if (sum == 0) {
            printf("0\n");
        }
        // Each flip changes the sum by 2
        else {
            printf("%d\n", abs(sum) / 2);
        }
    }

    return 0;
}
