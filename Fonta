#include <stdio.h>
#include <string.h>

int main() {
    char S[6];

    scanf("%s", S);

    int len = strlen(S);

    if (S[len - 3] == 'n' &&
        S[len - 2] == 't' &&
        S[len - 1] == 'a') {
        
        printf("YES\n");
    }
    else {
        printf("NO\n");
    }

    return 0;
}
