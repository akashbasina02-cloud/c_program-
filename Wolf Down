#include <stdio.h>

int main() {

    int T;
    scanf("%d", &T);  // Read number of test cases

    while (T--) {

        int N;
        scanf("%d", &N);  // Read length of string

        char S[101];
        scanf("%s", S);  // Read binary string

        int answer = 0;  // Count of safe birds

        // Check the string from left to right
        for (int i = 0; i < N; i++) {

            // If the animal is a bird
            if (S[i] == '0') {
                answer++;  // This bird is safe
            }

            // If we find the first wolf
            else {
                break;  // All birds after this wolf will be eaten
            }
        }

        // Print number of safe birds
        printf("%d\n", answer);
    }

    return 0;
}
