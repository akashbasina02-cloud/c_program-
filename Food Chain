
#include <stdio.h>

int main() {
    int T;
    scanf("%d", &T);

    while (T--) {
        long long E, K;
        scanf("%lld %lld", &E, &K);

        int count = 0;

        // Count levels receiving non-zero energy
        while (E > 0) {
            count++;
            E = E / K;
        }

        printf("%d\n", count);
    }

    return 0;
}
