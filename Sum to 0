#include <stdio.h>

int main() {

    // Number of test cases
    int T;
    scanf("%d", &T);

    // Process each test case
    while (T--) {

        // Read the size of the array
        int n;
        scanf("%d", &n);

        // For n = 1, no solution is possible
        if (n == 1) {
            printf("-1\n");
        }

        // If n is even
        else if (n % 2 == 0) {

            // Make pairs: 1 -1
            // Each pair has sum 0
            for (int i = 0; i < n / 2; i++) {
                printf("1 -1 ");
            }

            printf("\n");
        }

        // If n is odd (n >= 3)
        else {

            // First 3 numbers:
            // 1 + 2 - 3 = 0
            printf("1 2 -3");

            // Remaining numbers can be added
            // in pairs: 1 -1
            for (int i = 0; i < (n - 3) / 2; i++) {
                printf(" 1 -1");
            }

            printf("\n");
        }
    }

    return 0;
}
