#include <stdio.h>

int main() {
    int t;
    scanf("%d", &t);

    while (t--) {
        int x, y, z;
        scanf("%d %d %d", &x, &y, &z);

        if (x >= y) {
            printf("PIZZA\n");
        } else if (x >= z) {
            printf("BURGER\n");
        } else {
            printf("NOTHING\n");
        }
    }

    return 0;
}
